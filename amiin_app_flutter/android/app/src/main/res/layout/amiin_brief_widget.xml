<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Aujourd'hui » v3 — compact 4×2, trois zones :
     • FIXE   : température héros + chip prochaine prière
     • ROTATIF: ViewFlipper (5 s, glissement+fondu) — RDV ⇄ démarches ⇄ taux €/$
     • FIXE   : barre « Poser une question » + micro (ouvrent le chat)
     Chaque page rotative est tappable vers son écran de l'app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <!-- Zone fixe : météo héros + prière -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_weather_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/widget_ink"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widget_weather_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Météo"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_prayer_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="Prière · —"
            android:textColor="@color/widget_chip_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Zone rotative : RDV ⇄ démarches ⇄ taux (5 s, glissement + fondu) -->
    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:autoStart="true"
        android:flipInterval="5000"
        android:inAnimation="@anim/widget_slide_in"
        android:outAnimation="@anim/widget_slide_out">

        <TextView
            android:id="@+id/widget_event_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="📅  Aucun rendez-vous à venir"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_demarche_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="📋  Aucune démarche en cours"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_fx_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="💱  Taux du jour indisponible"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />
    </ViewFlipper>

    <!-- Zone fixe : question + micro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_ask_pill"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="💬  Demander à Amiin…"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_mic_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_mic_bg"
            android:gravity="center"
            android:text="🎤"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
