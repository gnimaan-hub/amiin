<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Aujourd'hui » v5 — carte de marque Amiin, compacte 4×2 :
     • EN-TÊTE : logo Amiin + « Aujourd'hui », température héros, chip prière
     • ROTATIF : ViewFlipper (5 s, glissement + fondu) — RDV ⇄ démarches ⇄ taux €/$
                 chaque page est une petite carte translucide, tappable vers l'app
     • ACTIONS : pilule « Demander à Amiin… » + bouton vocal (repris du chat)
     Fond dégradé turquoise → encre nuit + reflet (drawable/widget_background). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="13dp"
    android:paddingEnd="13dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <!-- ── En-tête : marque + météo héros + prière ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginEnd="8dp"
            android:src="@mipmap/launcher_icon"
            android:contentDescription="Amiin" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amiin"
                android:textColor="@color/widget_gold"
                android:textSize="15sp"
                android:letterSpacing="0.01"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUJOURD'HUI"
                android:textColor="@color/widget_muted"
                android:textSize="9sp"
                android:letterSpacing="0.18"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/widget_weather_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="23sp"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widget_weather_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Météo"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_prayer_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="🕌 —"
            android:textColor="@color/widget_chip_text"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />
    </LinearLayout>

    <!-- ── Zone rotative : petite carte qui défile (RDV ⇄ démarches ⇄ taux) ── -->
    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        android:autoStart="true"
        android:flipInterval="5000"
        android:inAnimation="@anim/widget_slide_in"
        android:outAnimation="@anim/widget_slide_out">

        <TextView
            android:id="@+id/widget_event_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_flip_card"
            android:gravity="center_vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="📅  Aucun rendez-vous à venir"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_demarche_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_flip_card"
            android:gravity="center_vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="📋  Aucune démarche en cours"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_fx_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_flip_card"
            android:gravity="center_vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="💱  Taux du jour indisponible"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />
    </ViewFlipper>

    <!-- ── Actions : question + bouton vocal (même bouton que le chat) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_ask_pill"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="💬  Demander à Amiin…"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/widget_mic_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/widget_mic_bg"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_mic"
            android:contentDescription="Dicter une question" />
    </LinearLayout>
</LinearLayout>
