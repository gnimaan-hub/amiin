<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Aujourd'hui » — reflet compact de la bande d'accueil de l'app.
     Toute la mise à jour vient de home_widget (Dart) ; ce layout ne fait
     qu'afficher les valeurs déjà calculées par home_brief_service. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- En-tête : nom + horodatage discret -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aujourd'hui"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/widget_updated_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Trois tuiles : météo / prochaine prière / taux de change -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/tile_weather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_weather_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_weather_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Météo"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/widget_border" />

        <LinearLayout
            android:id="@+id/tile_prayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_prayer_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_prayer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prière"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/widget_border" />

        <LinearLayout
            android:id="@+id/tile_fx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_fx_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_fx_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Taux"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
