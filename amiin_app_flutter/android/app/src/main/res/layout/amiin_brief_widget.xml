<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Aujourd'hui » v2 — quatre rangées :
     1. météo / prochaine prière / taux de change
     2. rendez-vous du jour (ou prochain de la semaine)
     3. démarches en cours
     4. barre « Poser une question » + micro (ouvrent le chat de l'app)
     Les valeurs viennent du stockage home_widget ; le provider Kotlin
     recalcule prochaine prière et RDV pertinent à chaque rafraîchissement. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AMIIN — AUJOURD'HUI"
            android:textColor="@color/widget_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_updated_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Rangée 1 : météo / prière / taux -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/tile_weather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_weather_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_weather_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Météo"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="@color/widget_border" />

        <LinearLayout
            android:id="@+id/tile_prayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_prayer_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_prayer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prière"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="@color/widget_border" />

        <LinearLayout
            android:id="@+id/tile_fx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/widget_fx_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_fx_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Taux"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_border"
        android:layout_marginBottom="8dp" />

    <!-- Rangée 2 : rendez-vous -->
    <TextView
        android:id="@+id/widget_event_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅  Aucun rendez-vous à venir"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="4dp" />

    <!-- Rangée 3 : démarches -->
    <TextView
        android:id="@+id/widget_demarche_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋  Aucune démarche en cours"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="10dp" />

    <!-- Rangée 4 : question + micro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_ask_pill"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Poser une question à Amiin…"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_mic_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_mic_bg"
            android:gravity="center"
            android:text="🎤"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
